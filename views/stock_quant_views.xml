<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 在库存报告(Stock On Hand)的tree视图中添加Volume列 -->
    <record id="view_stock_quant_tree_inherit_volume" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.volume</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="product_volume" string="Volume (m³)" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- 在库存报告的editable tree视图中也添加Volume列 -->
    <record id="view_stock_quant_tree_editable_inherit_volume" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.inherit.volume</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="product_volume" string="Volume (m³)" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

