<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_form_custom" model="ir.ui.view">
        <field name="name">account.move.form.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
           <group id="header_left_group" position="inside">
               <field name="is_sales_company" invisible="1"/>
               <field name="operating_company_id" attrs="{'invisible': [('is_sales_company', '=', False)]}"/>
           </group>
        </field>
    </record>
</odoo>
