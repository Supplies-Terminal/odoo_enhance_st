<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 客户账单映射关系列表视图 -->
    <record id="view_customer_billing_mapping_tree" model="ir.ui.view">
        <field name="name">customer.billing.mapping.tree</field>
        <field name="model">customer.billing.mapping</field>
        <field name="arch" type="xml">
            <tree string="客户账单映射关系">
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="billing_company_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- 客户账单映射关系表单视图 -->
    <record id="view_customer_billing_mapping_form" model="ir.ui.view">
        <field name="name">customer.billing.mapping.form</field>
        <field name="model">customer.billing.mapping</field>
        <field name="arch" type="xml">
            <form string="客户账单映射关系">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="billing_company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 客户账单映射关系搜索视图 -->
    <record id="view_customer_billing_mapping_search" model="ir.ui.view">
        <field name="name">customer.billing.mapping.search</field>
        <field name="model">customer.billing.mapping</field>
        <field name="arch" type="xml">
            <search string="客户账单映射关系">
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="billing_company_id"/>
                <filter string="当前公司" name="current_company" domain="[('company_id', '=', context_today().company_id.id)]"/>
                <filter string="启用" name="active" domain="[('active', '=', True)]"/>
                <filter string="禁用" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- 客户账单映射关系动作 -->
    <record id="action_customer_billing_mapping" model="ir.actions.act_window">
        <field name="name">客户账单映射关系</field>
        <field name="res_model">customer.billing.mapping</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_current_company': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建第一个客户账单映射关系
            </p>
            <p>
                在这里配置客户和对应公司的关系，系统将自动为这些客户生成每日账单。
            </p>
        </field>
    </record>

    <!-- 菜单项 -->
    <menuitem id="menu_customer_billing_mapping"
              name="客户账单映射"
              parent="account.menu_finance_configuration"
              action="action_customer_billing_mapping"
              sequence="20"/>
</odoo>
