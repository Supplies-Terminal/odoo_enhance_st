<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cross Company Billing Mapping Tree View -->
    <record id="view_customer_billing_mapping_tree" model="ir.ui.view">
        <field name="name">customer.billing.mapping.tree</field>
        <field name="model">customer.billing.mapping</field>
        <field name="arch" type="xml">
            <tree string="Cross Company Billing Mapping">
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="billing_company_id"/>
                <field name="billing_partner_id"/>
                <field name="chart_of_account_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Cross Company Billing Mapping Form View -->
    <record id="view_customer_billing_mapping_form" model="ir.ui.view">
        <field name="name">customer.billing.mapping.form</field>
        <field name="model">customer.billing.mapping</field>
        <field name="arch" type="xml">
            <form string="Cross Company Billing Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="billing_company_id"/>
                            <field name="billing_partner_id" 
                                   domain="[('is_company', '=', True), ('company_id', '=', billing_company_id)]"/>
                            <field name="chart_of_account_id"
                                   domain="[('company_id', '=', billing_company_id), ('deprecated', '=', False)]"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cross Company Billing Mapping Search View -->
    <record id="view_customer_billing_mapping_search" model="ir.ui.view">
        <field name="name">customer.billing.mapping.search</field>
        <field name="model">customer.billing.mapping</field>
        <field name="arch" type="xml">
            <search string="Cross Company Billing Mapping">
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="billing_company_id"/>
                <field name="billing_partner_id"/>
                <field name="chart_of_account_id"/>
                <filter string="My Company" name="my_company" domain="[('company_id', '=', uid.company_id.id)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Cross Company Billing Mapping Action -->
    <record id="action_customer_billing_mapping" model="ir.actions.act_window">
        <field name="name">Cross Company Billing Mapping</field>
        <field name="res_model">customer.billing.mapping</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Cross Company Billing mapping
            </p>
            <p>
                Configure the relationship between customers and corresponding companies here. The system will automatically generate daily bills for these customers.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_customer_billing_mapping" name="Cross Company Billing Mapping" parent="website.menu_st_settings" action="action_customer_billing_mapping" sequence="20"/>

</odoo>
