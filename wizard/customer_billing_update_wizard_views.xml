<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Billing Update Wizard Form View -->
    <record id="view_customer_billing_update_wizard_form" model="ir.ui.view">
        <field name="name">customer.billing.update.wizard.form</field>
        <field name="model">customer.billing.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Cross Company Billing Batch Wizard">
                <sheet>
                    <div class="oe_title">
                        <h1>Cross Company Billing Batch Wizard</h1>
                        <p>This wizard allows you to manually trigger billing updates for historical invoices and credit notes.</p>
                    </div>
                    
                    <group>
                        <group string="Configuration">
                            <field name="company_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Date Range">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                
                <footer>
                    <button name="action_process" 
                            string="Process" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Customer Billing Update Wizard Action -->
    <record id="action_customer_billing_update_wizard" model="ir.actions.act_window">
        <field name="name">Cross Company Billing Batch Wizard</field>
        <field name="res_model">customer.billing.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure the billing update parameters
            </p>
            <p>
                Select the company, customer, and date range to process historical invoices and credit notes, generating corresponding bills.
            </p>
            <p>
                <strong>Note:</strong> This wizard now processes both sales invoices and credit notes using the unified billing logic.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_customer_billing_update_wizard"
              name="Cross Company Billing Batch Wizard"
              parent="website.menu_st_settings"
              action="action_customer_billing_update_wizard"
              sequence="25"/>
</odoo>
